{
  "ci": {
    "collect": {
      "staticDistDir": ".",
      "url": [
        "http://localhost/",
        "http://localhost/parcours/",
        "http://localhost/pricing/",
        "http://localhost/contact/",
        "http://localhost/mentions-legales/",
        "http://localhost/confidentialite/"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 0.88, "aggregationMethod": "median-run" }],
        "categories:best-practices": ["error", { "minScore": 0.85, "aggregationMethod": "median-run" }],
        "categories:seo": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1, "aggregationMethod": "median-run" }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2500, "aggregationMethod": "median-run" }]
      }
    }
  }
}
