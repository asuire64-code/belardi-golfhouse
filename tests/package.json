{
  "name": "belardi-golfhouse-tests",
  "private": true,
  "description": "Garde-fous qualité du site BELARDI Golf House (le site lui-même n'utilise pas Node).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm run test:rapide && npm run test:navigateurs",
    "test:rapide": "node outils/verifier-code.js && node --test --test-reporter=spec \"statique/*.test.js\"",
    "test:navigateurs": "playwright test",
    "captures:maj": "playwright test affichage -g capture --update-snapshots",
    "dette:maj": "node outils/verifier-code.js --maj && DETTE_MAJ=1 playwright test accessibilite affichage -g \"accessibilité|débordement|lisible\" --workers=1",
    "rapport": "playwright show-report resultats/rapport"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/josefin-sans": "5.3.0",
    "@fontsource/jost": "5.3.0",
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "eslint-plugin-html": "8.2.1",
    "globals": "17.13.0",
    "html-validate": "11.17.0",
    "http-server": "14.1.1",
    "node-html-parser": "9.0.5",
    "postcss-html": "2.0.0",
    "stylelint": "17.16.0",
    "stylelint-config-recommended": "18.0.0"
  }
}
